+package nl.abelkrijgtalles.pathfinding; // Setup project
+
+import java.util.ArrayList;
+import java.util.List;
+
+public class Node implements Comparable<Node> {
+
+    public Node parent = null;
+
+    public List<Node> neighbors = new ArrayList<>();
+
+    public double totalCost = Double.MAX_VALUE;
+    public double cost;
+    public double estimatedCost;
+
+    public nl.abelkrijgtalles.pathfinding.platform.Location loc; // Setup project
+
+    private net.minecraft.world.level.Level level; // Setup project
+
+    public Node(nl.abelkrijgtalles.pathfinding.platform.Location l, net.minecraft.world.level.Level level, double c) { // Setup project
+
+        this.loc = l;
+        this.cost = c;
+        this.level = level; // Setup project
+    }
+
+    @Override
+    public int compareTo(Node n) {
+
+        return Double.compare(this.totalCost, n.totalCost);
+    }
+
+    //Similar to BFS
+    public void getBlocksAround(Node goal) {
+
+        // Start - Setup project
+        List<nl.abelkrijgtalles.pathfinding.platform.Location> locations = new ArrayList<>();
+
+        nl.abelkrijgtalles.pathfinding.platform.Location loc1 = this.loc.clone().add(1, 0, 0);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc2 = this.loc.clone().add(1, 1, 0);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc3 = this.loc.clone().add(1, -1, 0);
+
+        nl.abelkrijgtalles.pathfinding.platform.Location loc4 = this.loc.clone().add(-1, 0, 0);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc5 = this.loc.clone().add(-1, 1, 0);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc6 = this.loc.clone().add(-1, -1, 0);
+
+        nl.abelkrijgtalles.pathfinding.platform.Location loc7 = this.loc.clone().add(0, 0, 1);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc8 = this.loc.clone().add(0, 1, 1);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc9 = this.loc.clone().add(0, -1, 1);
+
+        nl.abelkrijgtalles.pathfinding.platform.Location loc10 = this.loc.clone().add(0, 0, -1);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc11 = this.loc.clone().add(0, 1, -1);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc12 = this.loc.clone().add(0, -1, -1);
+
+
+        nl.abelkrijgtalles.pathfinding.platform.Location loc13 = this.loc.clone().add(1, 0, 1);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc14 = this.loc.clone().add(1, 1, 1);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc15 = this.loc.clone().add(1, -1, 1);
+
+        nl.abelkrijgtalles.pathfinding.platform.Location loc16 = this.loc.clone().add(-1, 0, -1);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc17 = this.loc.clone().add(-1, 1, -1);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc18 = this.loc.clone().add(-1, -1, -1);
+
+        nl.abelkrijgtalles.pathfinding.platform.Location loc19 = this.loc.clone().add(-1, 0, 1);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc20 = this.loc.clone().add(-1, 1, 1);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc21 = this.loc.clone().add(-1, -1, 1);
+
+        nl.abelkrijgtalles.pathfinding.platform.Location loc22 = this.loc.clone().add(1, 0, -1);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc23 = this.loc.clone().add(1, 1, -1);
+        nl.abelkrijgtalles.pathfinding.platform.Location loc24 = this.loc.clone().add(1, -1, -1);
+        // End - Setup project
+
+        locations.add(loc1);
+        locations.add(loc2);
+        locations.add(loc3);
+        locations.add(loc4);
+        locations.add(loc5);
+        locations.add(loc6);
+        locations.add(loc7);
+        locations.add(loc8);
+        locations.add(loc9);
+        locations.add(loc10);
+        locations.add(loc11);
+        locations.add(loc12);
+        locations.add(loc13);
+        locations.add(loc14);
+        locations.add(loc15);
+        locations.add(loc16);
+        locations.add(loc17);
+        locations.add(loc18);
+        locations.add(loc19);
+        locations.add(loc20);
+        locations.add(loc21);
+        locations.add(loc22);
+        locations.add(loc23);
+        locations.add(loc24);
+
+        for (nl.abelkrijgtalles.pathfinding.platform.Location l : locations) { // Setup project
+            if (isStandable(l) && isMoveable(l)) {
+                Node o = new Node(l, level, cost + 1.5); // Setup project
+                //The *1.5 is to add weight to the distance, optimizes algorithm.
+                o.totalCost = 1.5 * o.calcHeuristics(goal) + o.cost;
+                o.estimatedCost = o.calcHeuristics(goal);
+                neighbors.add(o);
+            }
+        }
+    }
+
+    public boolean isStandable(nl.abelkrijgtalles.pathfinding.platform.Location l) { // Setup project
+
+        return net.minecraft.world.level.block.Block.isShapeFullBlock(level.getBlockState(l.asBlockPos()).getOcclusionShape()); // Setup project
+    }
+
+    public boolean isMoveable(nl.abelkrijgtalles.pathfinding.platform.Location l) { // Setup project
+
+        return level.getBlockState(l.clone().add(0, 1, 0).asBlockPos()).getOcclusionShape().isEmpty() && level.getBlockState(l.clone().add(0, 2, 0).asBlockPos()).getOcclusionShape().isEmpty(); // Setup project
+    }
+
+
+    public double calcHeuristics(Node goal) {
+
+        return Math.sqrt(nl.abelkrijgtalles.pathfinding.utils.NumberConversion.square(loc.x - goal.loc.x) + nl.abelkrijgtalles.pathfinding.utils.NumberConversion.square(loc.y - goal.loc.y) + nl.abelkrijgtalles.pathfinding.utils.NumberConversion.square(loc.z - goal.loc.z)); // Setup project
+    }
+
+}
