index 0000000000000000000000000000000000000000..64e4b91ef4cfa8421ef58f6916f3b7eb21dad386
--- /dev/null
+++ b/src/main/java/nl/abelkrijgtalles/pathfinding/AStar.java
@@ -0,0 +1,102 @@
+package nl.abelkrijgtalles.pathfinding; // Setup project
+
+import java.util.HashSet;
+import java.util.PriorityQueue;
+import java.util.Set;
+
+public class AStar {
+
+    private Node begin;
+    private Node goal;
+    private net.minecraft.world.level.block.Block mat = net.minecraft.world.level.block.Blocks.GLASS; // Setup project
+
+    private void computeNodes(nl.abelkrijgtalles.pathfinding.platform.Location start, nl.abelkrijgtalles.pathfinding.platform.Location end, net.minecraft.world.level.Level level) { // Setup project
+
+        this.begin = new Node(start, level, 0); // Setup project
+        this.goal = new Node(end, level, 0); // Setup project
+    }
+
+    public void computePath(nl.abelkrijgtalles.pathfinding.platform.Location start, nl.abelkrijgtalles.pathfinding.platform.Location end, net.minecraft.world.level.Level level) { // Setup project
+
+        computeNodes(start, end, level); // Setup project
+
+        PriorityQueue<Node> openList = new PriorityQueue<>();
+        PriorityQueue<Node> closedList = new PriorityQueue<>();
+
+        Set<nl.abelkrijgtalles.pathfinding.platform.Location> oLocation = new HashSet<>(); // Setup project
+        Set<nl.abelkrijgtalles.pathfinding.platform.Location> cLocation = new HashSet<>(); // Setup project
+
+        begin.totalCost = begin.cost + begin.calcHeuristics(goal);
+
+        begin.estimatedCost = begin.calcHeuristics(goal);
+
+        openList.add(begin);
+
+        oLocation.add(begin.loc.getBlockPosition()); // Setup project
+
+        final Node[] listnode = {null};
+
+        new Thread(new Runnable() { // Setup project
+
+            @Override
+            public void run() {
+
+                Node n = openList.peek();
+
+                n.getBlocksAround(goal);
+
+                openList.remove(n);
+                closedList.add(n);
+
+                oLocation.remove(n.loc.getBlockPosition()); // Setup project
+                cLocation.add(n.loc.getBlockPosition()); // Setup project
+
+                for (Node m : n.neighbors) {
+                    double totalWeight = n.cost + n.calcHeuristics(m);
+                    if (!oLocation.contains(m.loc.getBlockPosition()) && !cLocation.contains(m.loc.getBlockPosition())) { // Setup project
+                        m.parent = n;
+                        m.cost = totalWeight;
+                        //The *1.5 is to add weight to the distance, optimizes algorithm.
+                        m.totalCost = m.cost + 1.5 * m.calcHeuristics(goal);
+
+                        openList.add(m);
+                        oLocation.add(m.loc.getBlockPosition()); // Setup project
+                    } else {
+                        if (totalWeight < m.cost) {
+                            m.parent = n;
+                            m.cost = totalWeight;
+                            m.totalCost = m.cost + 1.5 * m.calcHeuristics(goal);
+                            if (closedList.contains(m)) {
+                                closedList.remove(m);
+                                openList.add(m);
+
+                                cLocation.remove(m.loc.getBlockPosition()); // Setup project
+                                oLocation.add(m.loc.getBlockPosition()); // Setup project
+                            }
+                        }
+                    }
+                }
+                if (n.loc.equals(goal.loc)) { // Setup project
+                    Thread.currentThread().interrupt(); // Setup project
+                    listnode[0] = n;
+                    displayPath(listnode[0], level);
+                }
+            }
+        }).start(); // Setup project
+
+    }
+
+    private void displayPath(Node n, net.minecraft.world.level.Level level) {
+
+        while (n != null) {
+            level.setBlock(n.loc.clone().add(0, 1, 0).asBlockPos(), this.mat.defaultBlockState(), 3); // Setup project
+            n = n.parent;
+        }
+    }
+
+    public void setMaterial(net.minecraft.world.level.block.Block m) { // Setup project
+
+        this.mat = m;
+    }
+
+}
