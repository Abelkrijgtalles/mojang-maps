{
  "schemaVersion": 1,
  "id": "mojang_maps",
  "version": "${version}",
  "name": "Mojang Maps",
  "description": "A Google Maps like navigation system for Minecraft.",
  "authors": [
    "Abelpro678",
    "Contributors"
  ],
  "contact": {
    "homepage": "https://github.com/Abelkrijgtalles/mojang-maps",
    "sources": "https://github.com/Abelkrijgtalles/mojang-maps",
    "issues": "https://github.com/Abelkrijgtalles/mojang-maps/issues"
  },
  "license": "GPLv3",
  "icon": "assets/mojang_maps/icon.png",
  "environment": "*",
  "entrypoints": {
    "server": [
      "nl.abelkrijgtalles.mojangmaps.fabric.FabricMojangMaps"
    ]
  },
  "mixins": [
    "mojang_maps.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": $compatible_minecraft_versions,
    "java": ">=${java_version}"
